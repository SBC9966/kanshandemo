# Optional. Leave blank for a fully functional offline demo.
# Full HTTPS URL of an OpenAI-compatible Chat Completions endpoint.
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
PORT=8787

# Zhihu Open Platform (server-side only). Get Access Secret at https://developer.zhihu.com/profile
# ZHIHU_API_KEY=

# ── 知乎 OAuth（可选：用知乎账号登录）────────────────────────────────
# 从黑客松赛事页面创建项目后领取 App ID / App Key，并把回调地址登记为下面这个值。
# 三个都填好，页面才会出现「用知乎登录」按钮；缺任何一个按钮都不显示（不会假装能登录）。
# 本地联调：回调必须是公网 HTTPS，建议用 Vercel 域名；本地端口只能用于 self-test。
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=https://你的域名/api/zhihu/oauth/callback
